# All settings here are optional - the app's Settings dialog saves them to a
# per-user config.toml instead. This file is only read from the working
# directory, as a lower-priority fallback.

[ai]
# Vision-capable model. gpt-5-mini gives noticeably richer, more accurate
# detail-catching than gpt-4o-mini for roughly the same cost per image.
model = "gpt-5-mini"
# Optional: Override the base URL if you want to use a compatible proxy/local endpoint
# base_url = "https://api.openai.com/v1"
# Optional: Set API key here. Prefer entering it in the app's Settings dialog
# (stored in the OS credential store) or the OPENAI_API_KEY env var, so the
# key doesn't need to live in a plain-text file.
# api_key = "sk-..."

# Images are downscaled so their longest edge does not exceed this many pixels
# before being sent to the AI, to reduce upload size, latency, and token cost.
max_image_dimension = 1024

# Optional: override the built-in system prompt
# (src/metajot/data/system_prompt.txt).
# [prompts]
# system_prompt = """..."""
